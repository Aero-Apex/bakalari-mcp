# Settings for bakalari-mcp. `bakalari-mcp setup` writes the real file for you; this is the full list by hand.
# The file lives in your per-user folder (see README "Settings"); BAKALARI_CONFIG=/path/file.env uses another one.
# Environment variables with the same names override these values.

BAKALARI_URL="https://school.example.cz"

# Login: choose ONE of these (setup writes the right one).
# 1. A cookie kept alive by the keeper service (or the browser extension):
# BAKALARI_COOKIE_FILE="/path/to/data/session.json"
# or a one-off cookie copied from the browser (it expires with the website session):
# BAKALARI_COOKIE="Cookie header value from the logged-in website"
# 2. Username and password (REST API, no cookie):
# BAKALARI_USERNAME="your_username"
# BAKALARI_PASSWORD="your_password"

# Optional
# BAKALARI_TZ="Europe/Prague"
# BAKALARI_TIMEOUT=30
# BAKALARI_CACHE_TTL=120
# BAKALARI_COOKIE_MAX_AGE=1200
# BAKALARI_KEEPER_INTERVAL=180
# BAKALARI_DATA_DIR="/path/to/data"
# BAKALARI_LOG_LEVEL=WARNING

# Browser-extension receiver (bakalari-mcp setup, extension option)
# BAKALARI_RECEIVER_HOST="127.0.0.1"
# BAKALARI_RECEIVER_PORT=8765
# BAKALARI_RECEIVER_TOKEN="at least 16 characters"

# HTTP connector for a Cloudflare tunnel (bakalari-mcp http-setup)
# BAKALARI_HTTP_HOST="127.0.0.1"
# BAKALARI_HTTP_PORT=8770
# BAKALARI_HTTP_HOSTS="mcp.example.com"
# BAKALARI_HTTP_TOKEN="at least 24 characters"
